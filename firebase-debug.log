[debug] [2026-09-03T09:59:48.496Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/gestao-fiscal-38b30:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Documento-pai do usuário ─────────────────────────────────────\n    // O Firestore exige permissão no documento-pai mesmo quando a operação\n    // real é numa subcoleção. Sem isso o SDK lança \"Missing or insufficient permissions\".\n    match /users/{uid} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n\n    // ── Documentos fiscais ───────────────────────────────────────────\n    match /users/{uid}/documents/{docId} {\n\n      // Dono autenticado tem acesso total (leitura, escrita, exclusão).\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n\n      // ── Compartilhamento público (link por token) ────────────────\n      // Qualquer pessoa (incluindo não autenticada) pode LER um documento\n      // cujo campo `sharedToken` esteja preenchido.\n      // Isso permite que a página /share/:token funcione sem login.\n      // Escrever/excluir continua restrito ao dono pela regra acima.\n      allow read: if resource.data.sharedToken is string\n                  && resource.data.sharedToken.size() > 0;\n    }\n\n    // ── Acesso por collectionGroup para a query de busca por token ───\n    // getDocumentByToken() usa collectionGroup('documents') + where('sharedToken','==',token).\n    // Esta regra permite essa query pública (somente leitura).\n    match /{path=**}/documents/{docId} {\n      allow read: if resource.data.sharedToken is string\n                  && resource.data.sharedToken.size() > 0;\n    }\n\n  }\n}\n"}]}}
