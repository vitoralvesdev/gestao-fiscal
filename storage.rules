rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Arquivos do usuário ──────────────────────────────────────────
    // Acesso total apenas pelo próprio dono autenticado.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Compartilhamento público (arquivos) ──────────────────────────
    // O Storage não consegue consultar o Firestore diretamente nas rules,
    // então a estratégia é a seguinte:
    //
    //   1. O visitante público abre /share/:token no navegador.
    //   2. O front faz uma query no Firestore (permitida pela rule de
    //      collectionGroup acima) e obtém o `storagePath` do arquivo.
    //   3. O front chama getDownloadURL() — que retorna um URL temporário
    //      assinado pelo Firebase Storage sem expor o bucket publicamente.
    //
    // Isso mantém o Storage fechado e usa o mecanismo nativo do Firebase
    // de URLs temporários autenticados.
    //
    // Se no futuro quiser download direto (ex: <img src="...">), crie uma
    // coleção `publicTokens/{token}` no Firestore e descomente abaixo:
    //
    // match /users/{uid}/{allPaths=**} {
    //   allow read: if firestore.get(
    //     /databases/(default)/documents/publicTokens/$(request.resource.name)
    //   ).data.active == true;
    // }

  }
}
